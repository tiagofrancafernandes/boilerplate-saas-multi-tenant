APP_NAME="SaaS Multi-Tenant API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL Primary Database
DB_CONNECTION=pgsql
DB_HOST=172.17.0.1
DB_PORT=1010
DB_DATABASE=dev_boilerplate_saas
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=saas_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=172.17.0.1
REDIS_PASSWORD=null
REDIS_PORT=1020

# Mailpit SMTP
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=172.17.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@local.basecartao.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Storage (MinIO S3)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=generic
AWS_ENDPOINT=http://172.17.0.1:9001
AWS_USE_PATH_STYLE_ENDPOINT=true

# SaaS Subscription & Multi-Tenancy Settings
SUBSCRIPTION_TRIAL_ENABLED=true
SUBSCRIPTION_TRIAL_DAYS=14
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# Infrastructure & Operational Settings
INFRA_SCHEDULER_ENABLED=true
INFRA_QUEUE_ENABLED=true
INFRA_ARTISAN_ENABLED=true
INFRA_SCHEDULER_AUTH_TOKEN=change-this-to-a-secure-random-token
INFRA_SCHEDULER_HEADER_NAME=X-Infra-Key
INFRA_WEBHOOK_TIMEOUT=5
SEED_DEMO_USERS=false

