{
    "name": "boilerplate-saas-multi-tenant",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@11.10.0",
    "scripts": {
        "dev": "turbo run dev",
        "dev:site": "turbo run dev --filter=@saas/site",
        "dev:web": "turbo run dev --filter=@saas/web",
        "dev:admin": "turbo run dev --filter=@saas/admin",
        "dev:api": "cd apps/api && php artisan serve",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "lint:php": "cd apps/api && ./vendor/bin/pint --test",
        "format:php": "cd apps/api && ./vendor/bin/pint",
        "format": "prettier --write . && cd apps/api && ./vendor/bin/pint",
        "test": "pnpm test:php && pnpm test:ui",
        "test:php": "cd apps/api && php artisan test",
        "test:ui": "pnpm --filter=@saas/ui test",
        "pm2:start": "pm2 start ecosystem.config.cjs",
        "pm2:stop": "pm2 stop ecosystem.config.cjs",
        "pm2:restart": "pm2 restart ecosystem.config.cjs",
        "pm2:status": "pm2 status",
        "pm2:logs": "pm2 logs",
        "pm2:delete": "pm2 delete ecosystem.config.cjs"
    },
    "devDependencies": {
        "prettier": "^3.5.3",
        "turbo": "^2.4.4",
        "typescript": "^5.8.2"
    }
}
